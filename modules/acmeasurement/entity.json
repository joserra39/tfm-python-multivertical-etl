{
  "id": "{station_id}",
  "type": "ACMeasurement",

  "name": {
    "type": "Text",
    "value": "{name}"
  },

  "dateObserved": {
    "type": "DateTime",
    "value": "{dateObserved}"
  },

  "location": {
    "type": "Text",
    "value": {
      "type": "Point",
      "coordinates": "{coordinates}"
    }
  },

  "source": {
    "type": "Text",
    "value": "{source}"
  },

  "address": {
    "type": "Text",
    "value": "{address}"
  },

  "building": {
    "type": "Text",
    "value": "{building}"
  },
  "areaServed": {
    "type": "Text",
    "value": "{areaServed}"
  },

  "measurementType": {
    "type": "Text",
    "value": "{measurementType}"
  },

  "energy": {
    "type": "Number",
    "value": "{energy}"
  },

  "energyUnit": {
    "type": "Text",
    "value": "{energyUnit}"
  },

  "period": {
    "type": "Text",
    "value": "{period}"
  }
}