{
  "id": "{station_id}",
  "type": "NoiseLevelObserved",

  "name": {
    "type": "Text",
    "value": "{station_name}"
  },

  "dateObserved": {
    "type": "DateTime",
    "value": "{dateObserved}"
  },

  "location": {
    "type": "Text",
    "value": {
      "type": "Point",
      "coordinates": "{coordinates}"
    }
  },

  "address": {
    "type": "PostalAddress",
    "value": {
      "addressCountry": "ES",
      "addressLocality": "Madrid",
      "streetAddress": "{station_name}"
    }
  },

  "source": {
    "type": "Text",
    "value": "{source}"
  }
}